<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="?android:colorBackground">

    <!-- 16:9 YouTube Thumbnail Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/thumbnailcard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="6dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:srcCompat="@tools:sample/backgrounds/scenic" />

            <androidx.cardview.widget.CardView
                android:id="@+id/sponsor_badge_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:visibility="gone"
                app:cardBackgroundColor="?colorSecondaryContainer"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/sponsor_badge_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:src="@drawable/ic_paid_content"
                    android:layout_gravity="center"
                    app:tint="?colorOnSecondaryContainer" />

            </androidx.cardview.widget.CardView>

            <!-- YouTube Duration Badge -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#E6000000"
                app:cardCornerRadius="4dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toTopOf="@id/watch_progress"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/thumbnail_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="05:36" />

            </androidx.cardview.widget.CardView>

            <View
                android:id="@+id/watch_progress"
                style="@style/WatchProgress"
                android:layout_height="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Circular Channel Avatar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/channel_image_container"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="19dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/thumbnailcard">

        <ImageView
            android:id="@+id/channel_image"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:scaleType="centerCrop"
            tools:srcCompat="@mipmap/ic_launcher" />

    </androidx.cardview.widget.CardView>

    <!-- Video Title -->
    <TextView
        android:id="@+id/textView_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14.5sp"
        android:textStyle="bold"
        android:lineSpacingExtra="2dp"
        app:layout_constraintEnd_toStartOf="@+id/three_dots_menu"
        app:layout_constraintStart_toEndOf="@+id/channel_image_container"
        app:layout_constraintTop_toBottomOf="@+id/thumbnailcard"
        tools:text="Title that spans up to two lines in YouTube feed format" />

    <!-- Channel Name & Views -->
    <TextView
        android:id="@+id/textView_channel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingBottom="4dp"
        android:textAlignment="viewStart"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@+id/textView_title"
        app:layout_constraintStart_toStartOf="@+id/textView_title"
        app:layout_constraintTop_toBottomOf="@+id/textView_title"
        tools:text="Channel Name • 1.2M views • 2 weeks ago" />

    <!-- YouTube Style Three-Dot Menu -->
    <ImageView
        android:id="@+id/three_dots_menu"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:padding="2dp"
        android:src="@drawable/ic_three_dots"
        app:tint="?android:attr/textColorSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/thumbnailcard" />

</androidx.constraintlayout.widget.ConstraintLayout>
