<?xml version="1.0" encoding="utf-8"?>
<com.example.liquidglass.LiquidGlassView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogGlassRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cornerRadius="24dp"
    app:glassMaterial="regular"
    app:refractionHeight="16dp"
    app:bevelWidth="28dp"
    app:dispersionStrength="0.12"
    app:sensorHighlight="true"
    app:adaptiveTint="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D9111422"
        android:orientation="vertical"
        android:padding="22dp">

    <!-- Header Logo & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/mytube_icon"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Welcome to MyTube"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Futuristic Cyber-Tech Video App"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Creator Row -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#3300E5FF"
        app:cardBackgroundColor="#171A29">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="#00E5FF"
                app:cardBackgroundColor="#000000">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/creator_avatar"
                    android:contentDescription="Creator" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="mokka coding"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Creator &amp; Architect"
                    android:textColor="#8F9CAE"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/dialogInstaBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_instagram"
                android:contentDescription="Instagram" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Highlights -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="4dp"
        android:text="◆ Full-width YouTube feed design\n◆ Ad-Free playback &amp; background audio\n◆ Download high quality videos &amp; music\n◆ Zero ads · 100% privacy focus"
        android:textColor="#C5CCE0"
        android:textSize="12.5sp" />

    <!-- Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/welcomeDismissBtn"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:backgroundTint="#00E5FF"
        android:text="START EXPLORING"
        android:textColor="#000000"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

    </LinearLayout>
</com.example.liquidglass.LiquidGlassView>
